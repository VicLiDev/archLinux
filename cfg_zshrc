# ~/.zshrc

# 只在交互式 shell 中加载；脚本或非交互调用直接返回
[[ -o interactive ]] || return 0

# ------------------------------------------------------------
# 登录提示
# ------------------------------------------------------------
# 每个新的交互式终端显示一次。
function _show_arch_banner()
{
  local -a logo=(
    '                   -`'
    '                  .o+`'
    '                 `ooo/'
    '                `+oooo:'
    '               `+oooooo:'
    '               -+oooooo+:'
    '             `/:-:++oooo+:'
    '            `/++++/+++++++:'
    '           `/++++++++++++++:'
    '          `/+++ooooooooooooo/`'
    '         ./ooosssso++osssssso+`'
    '        .oossssso-````/ossssss+`'
    '       -osssssso.      :ssssssso.'
    '      :osssssss/        osssso+++.'
    '     /ossssssss/        +ssssooo/-'
    '   `/ossssso+/:-        -:/+osssso+-'
    '  `+sso+:-`                 `.-/+oso:'
    ' `++:.                           `-/+'
    ' .`                                 `/'
  )

  local cols="${COLUMNS:-0}"
  if (( cols <= 0 )); then
    cols=$(tput cols 2>/dev/null)
    cols="${cols:-80}"
  fi

  if (( cols < 48 )); then
    printf '\033[1;38;2;125;207;255m  Arch Linux\033[0m\n'
    return
  fi

  local show_info=0
  (( cols >= 80 )) && show_info=1

  local -a labels values
  if (( show_info )); then
    local term_name="${TERM:-terminal}"
    [[ "${term_name}" == "xterm-kitty" ]] && term_name='kitty'

    local wm='Wayland'
    if [[ -n "${NIRI_SOCKET}" || "${XDG_CURRENT_DESKTOP:-}" == *niri* ]]; then
      wm='niri'
    elif [[ -n "${HYPRLAND_INSTANCE_SIGNATURE}" || "${XDG_CURRENT_DESKTOP:-}" == *Hyprland* ]]; then
      wm='Hyprland'
    fi

    local up='unknown'
    if (( ${+commands[uptime]} )); then
      up="$(uptime -p 2>/dev/null)"
      up="${up#up }"
      [[ -z "${up}" ]] && up='unknown'
    fi

    labels=( 'OS' 'Host' 'Kernel' 'Shell' 'Terminal' 'WM' 'Theme' 'Uptime' 'Date' )
    values=(
      'Arch Linux'
      "$(uname -n)"
      "$(uname -r)"
      "zsh ${ZSH_VERSION}"
      "${term_name}"
      "${wm}"
      'DMS + Material 3'
      "${up}"
      "$(date '+%Y-%m-%d %H:%M')"
    )
  fi

  local width=40
  (( show_info )) && width=79
  local pad=$(( (cols - width) / 2 ))
  (( pad < 0 )) && pad=0

  local i pos seg frac r g b line
  local n=${#logo}
  local -a info_labels info_values
  info_labels=( "${labels[@]}" )
  info_values=( "${values[@]}" )

  # 冷色霓虹渐变：天蓝 -> 蓝 -> 淡紫 -> 粉。
  local -a sr=( 125 122 187 255 )
  local -a sg=( 207 162 154 121 )
  local -a sb=( 255 247 247 198 )
  local stops=${#sr}
  local maxpos=$(( (stops - 1) * 100 ))

  for (( i = 0; i < n; i++ )); do
    pos=$(( i * maxpos / (n - 1) ))
    seg=$(( pos / 100 ))
    frac=$(( pos % 100 ))
    if (( seg >= stops - 1 )); then
      seg=$(( stops - 2 ))
      frac=100
    fi

    r=$(( sr[seg + 1] + (sr[seg + 2] - sr[seg + 1]) * frac / 100 ))
    g=$(( sg[seg + 1] + (sg[seg + 2] - sg[seg + 1]) * frac / 100 ))
    b=$(( sb[seg + 1] + (sb[seg + 2] - sb[seg + 1]) * frac / 100 ))

    line="${logo[i + 1]}"
    printf '%*s\033[1;38;2;%d;%d;%dm%-40s\033[0m' \
      "${pad}" '' "${r}" "${g}" "${b}" "${line}"

    if (( show_info )); then
      printf '  \033[38;2;%d;%d;%dm│\033[0m  ' "${r}" "${g}" "${b}"
      if (( i == 0 )); then
        printf '\033[1;38;2;255;255;255m Arch Linux\033[0m'
      elif (( i == 1 )); then
        printf '\033[1;38;2;255;121;198m──────────────\033[0m'
      else
        local j=$(( i - 1 ))
        if (( j >= 1 && j <= ${#info_labels[@]} )); then
          printf '\033[1;38;2;%d;%d;%dm%-8s\033[0m \033[38;2;255;255;255m%s\033[0m' \
            "${r}" "${g}" "${b}" "${info_labels[j]}" "${info_values[j]}"
        fi
      fi
    fi

    printf '\n'
  done

  printf '\033[0m\n'
}

if [[ -t 1 ]]; then
  _show_arch_banner
fi

# ------------------------------------------------------------
# 历史记录
# ------------------------------------------------------------
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_VERIFY
setopt SHARE_HISTORY

# 上下方向键按当前输入的前缀过滤历史，而不是遍历全部历史
# 连续上翻时保留第一次的前缀，例如 "cd Pro" 不会在第二次变成整条命令
typeset -g _history_prefix=''
typeset -g _history_last_buffer=''
typeset -g _history_original=''

function _history_search_reset()
{
  _history_prefix=''
  _history_last_buffer=''
  _history_original=''
}

function _history_search_prepare()
{
  if [[ "${BUFFER}" != "${_history_last_buffer}" ]]; then
    _history_prefix="${BUFFER[1,CURSOR]}"
    _history_original="${BUFFER}"
  fi

  # 只把光标移到前缀末尾，保留 BUFFER 和 zsh 的历史搜索位置；
  # 直接改写 BUFFER 会让 history-beginning-search-forward 找不到下一条。
  CURSOR=${#_history_prefix}
}

function _history_search_backward()
{
  _history_search_prepare
  zle history-beginning-search-backward
  _history_last_buffer="${BUFFER}"
  CURSOR=${#BUFFER}
  POSTDISPLAY=''
}

function _history_search_forward()
{
  _history_search_prepare
  zle history-beginning-search-forward

  if [[ "${BUFFER}" == "${_history_prefix}" ]]; then
    BUFFER="${_history_original}"
    _history_last_buffer=''
  else
    _history_last_buffer="${BUFFER}"
  fi

  CURSOR=${#BUFFER}
  POSTDISPLAY=''
}

zle -N _history_search_backward
zle -N _history_search_forward
bindkey '^[[A' _history_search_backward
bindkey '^[[B' _history_search_forward
bindkey '^[OA' _history_search_backward
bindkey '^[OB' _history_search_forward

autoload -Uz add-zsh-hook
add-zsh-hook precmd _history_search_reset

# ------------------------------------------------------------
# 补全
# ------------------------------------------------------------
zcompdump="${XDG_CACHE_HOME:-${HOME}/.cache}/zsh/zcompdump-${HOST}-${ZSH_VERSION}"
mkdir -p -- "${zcompdump:h}/zcompcache"

autoload -Uz compinit
compinit -d "${zcompdump}"

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${zcompdump:h}/zcompcache"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' list-prompt '%SAt %p: TAB for more, any other key to insert%s'

setopt AUTO_CD
setopt AUTO_MENU
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt INTERACTIVE_COMMENTS
setopt COMPLETE_IN_WORD
setopt ALWAYS_TO_END

# ------------------------------------------------------------
# 原有 bash 工具
# ------------------------------------------------------------
# pers_cfg.sh 内部会 source _source_cmd_tools.sh，只加载这一处，
# 避免同一次启动重复初始化 conda 和重复定义函数。
if [[ -f "${HOME}/bin/pers_cfg.sh" ]]; then
  source "${HOME}/bin/pers_cfg.sh"
elif [[ -r "${HOME}/bin/_source_cmd_tools.sh" ]]; then
  source "${HOME}/bin/_source_cmd_tools.sh"
fi

# ------------------------------------------------------------
# fzf：Ctrl-R / Ctrl-T / Alt-C
# ------------------------------------------------------------
if [[ -r /usr/share/fzf/key-bindings.zsh ]]; then
  source /usr/share/fzf/key-bindings.zsh
fi
if [[ -r /usr/share/fzf/completion.zsh ]]; then
  source /usr/share/fzf/completion.zsh
fi

# ------------------------------------------------------------
# 自动建议
# ------------------------------------------------------------
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
if [[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# 历史搜索组件自己清理 POSTDISPLAY，禁止自动建议再包一层
ZSH_AUTOSUGGEST_IGNORE_WIDGETS+=(_history_search_backward _history_search_forward)

# 右方向键优先接受灰色建议；没有建议时保持正常的右移
function _accept_autosuggest_or_forward_char()
{
  if [[ -n "${POSTDISPLAY}" ]]; then
    zle autosuggest-accept
  else
    zle forward-char
  fi
}
zle -N _accept_autosuggest_or_forward_char
bindkey '^[[C' _accept_autosuggest_or_forward_char
bindkey '^[OC' _accept_autosuggest_or_forward_char

# ------------------------------------------------------------
# 目录跳转与提示符
# ------------------------------------------------------------
if (( ${+commands[zoxide]} )); then
  eval "$(zoxide init zsh)"
fi

if (( ${+commands[starship]} )); then
  eval "$(starship init zsh)"
fi

# ------------------------------------------------------------
# 分页器与 fzf 配色
# ------------------------------------------------------------
export PAGER='less'
export MANPAGER='less -R'
export LESS='-R'

# less 的 man 页配色，尽量接近 Catppuccin Mocha
export LESS_TERMCAP_mb=$'\e[1;31m'
export LESS_TERMCAP_md=$'\e[1;34m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[1;33;44m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;32m'

# fzf 使用 Catppuccin Mocha 色板
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border \
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
  --color=marker:#a6e3a1,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"

# ------------------------------------------------------------
# 常用别名
# ------------------------------------------------------------
if (( ${+commands[eza]} )); then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -lh --icons --git'
  alias la='eza -lah --icons --git'
  alias lt='eza --tree --level=2 --icons'
fi

if (( ${+commands[bat]} )); then
  alias cat='bat --style=plain --paging=never'
fi

# ------------------------------------------------------------
# 语法高亮必须最后加载
# ------------------------------------------------------------
if [[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# >>> conda initialize >>>
# 工具脚本通常已经初始化过 conda；仅在尚未激活时再执行一次。
if [[ -z "${CONDA_DEFAULT_ENV:-}" ]]; then
  __conda_setup="$('/home/lhj/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
      eval "$__conda_setup"
  else
      if [ -f "/home/lhj/anaconda3/etc/profile.d/conda.sh" ]; then
          . "/home/lhj/anaconda3/etc/profile.d/conda.sh"
      else
          export PATH="/home/lhj/anaconda3/bin:$PATH"
      fi
  fi
  unset __conda_setup
fi
# <<< conda initialize <<<

